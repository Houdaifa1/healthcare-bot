NODE_ENV=development
PORT=3000
DATABASE_URL=
REDIS_URL=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# Local Ollama server — no patient message is ever sent to a public/cloud AI
# API. OLLAMA_MODEL is used for the outbound campaign conversation;
# OLLAMA_CLASSIFIER_MODEL is a smaller/faster model for inbound intent/
# language/FAQ classification (src/conversation/nlu/intent-classifier.service.ts), since the message
# queue processes one job at a time and a slow classifier call blocks
# everyone. If Ollama is unreachable the bot still works via keyword-only
# fallback matching, with semantic FAQ matching and AI-assisted
# disambiguation degraded until it recovers.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=healthcare-bot:latest
OLLAMA_CLASSIFIER_MODEL=healthcare-bot:latest
# Approved Meta template for the campaign opening message (name + BCP-47 language code)
CAMPAIGN_OPENING_TEMPLATE_NAME=patient_followup
CAMPAIGN_OPENING_TEMPLATE_LANGUAGE=fr
JWT_SECRET=
SEED_ADMIN_EMAIL=admin@clinic.com
SEED_ADMIN_PASSWORD=changeme123
