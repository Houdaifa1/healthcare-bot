NODE_ENV=development
PORT=3000
DATABASE_URL=
REDIS_URL=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# Local Ollama server. The same model handles inbound classification and
# campaign conversation. Validate language quality and latency before use.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
# Leave blank to use mock without credentials and live with all credentials.
# Set mock explicitly to test real WhatsApp against local ClinOps fixtures.
CLINOPS_MODE=
# Documented staging base: https://stage.clinops.app/new-backend/external_module
CLINOPS_BASE_URL=
CLINOPS_USERNAME=
CLINOPS_PASSWORD=
# Approved Meta template for the campaign opening message (name + BCP-47 language code)
CAMPAIGN_OPENING_TEMPLATE_NAME=patient_followup
CAMPAIGN_OPENING_TEMPLATE_LANGUAGE=fr
# Approved reminder template with two body parameters: patient name, visit date.
CAMPAIGN_REMINDER_TEMPLATE_NAME=
CAMPAIGN_REMINDER_TEMPLATE_LANGUAGE=fr
JWT_SECRET=
SEED_ADMIN_EMAIL=admin@clinic.com
SEED_ADMIN_PASSWORD=
