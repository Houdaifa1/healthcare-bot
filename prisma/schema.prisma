generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Clinic Configuration ────────────────────────────────────────────────────
model Clinic {
  id                     String       @id @default(cuid())
  name                   String
  phone                  String
  address                String?
  timezone               String       @default("Africa/Casablanca")
  defaultLanguage        Language     @default(FR)
  supportedLangs         Language[]   @default([FR, EN])
  isActive               Boolean      @default(true)

  // ── Campaign / follow-up settings ──
  notificationPhone      String?
  campaignDelayHours     Int          @default(24)
  reminderCount          Int          @default(1)
  reminderIntervalHours  Int          @default(48)
  aiMaxTurns             Int          @default(20)

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  botMessages            BotMessage[]
  faqs                   FAQ[]
  appointments           Appointment[]
  adminUsers             AdminUser[]
  campaigns              Campaign[]
  handoffs               Handoff[]
}

// ─── Bot Message Templates ───────────────────────────────────────────────────
model BotMessage {
  id        String     @id @default(cuid())
  clinicId  String
  key       MessageKey
  body      String
  language  Language   @default(FR)
  updatedAt DateTime   @updatedAt
  clinic    Clinic     @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, key, language])
}

// ─── Specialties ─────────────────────────────────────────────────────────────
// ─── Appointments ─────────────────────────────────────────────────────────────
model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  // No FK to a local Doctor/Specialty table — those don't exist. doctorId/
  // specialtyId hold the ClinOps identity (or are null pending a live-mode
  // mapping — see booking-requests.service.ts); doctorName/specialtyName are
  // the durable, always-populated display record.
  doctorId        String?
  specialtyId     String?
  patientName     String
  patientPhone    String
  appointmentDate DateTime
  appointmentTime String
  status          AppointmentStatus @default(PENDING)
  notes           String?
  doctorName      String?
  specialtyName   String?
  source          BookingSource     @default(CAMPAIGN)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  clinic          Clinic            @relation(fields: [clinicId], references: [id])

  bookingRequest  BookingRequest?
}

// ─── FAQs ─────────────────────────────────────────────────────────────────────
model FAQ {
  id           String   @id @default(cuid())
  clinicId     String
  question     String
  answer       String
  keywords     String[]
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  language     Language @default(FR)
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
}

// ─── Admin Users ──────────────────────────────────────────────────────────────
model AdminUser {
  id           String     @id @default(cuid())
  clinicId     String?
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(CLINIC_ADMIN)
  createdAt    DateTime   @default(now())
  clinic       Clinic?    @relation(fields: [clinicId], references: [id])
  auditLogs    AuditLog[]
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  action      String
  entity      String
  entityId    String?
  payload     Json?
  createdAt   DateTime  @default(now())
  admin       AdminUser @relation(fields: [adminUserId], references: [id])
}

// ─── Campaign ─────────────────────────────────────────────────────────────────
model Campaign {
  id                String           @id @default(cuid())
  clinicId          String
  name              String
  status            CampaignStatus   @default(DRAFT)
  scheduledStartAt  DateTime?

  filterDateFrom       DateTime?
  filterDateTo         DateTime?
  filterDoctors        String[]      @default([])
  filterMotifs         String[]      @default([])
  filterCinPassports   String[]      @default([])
  filterPhoneNumbers   String[]      @default([])
  onlyVerifiedNumbers  Boolean       @default(true)

  notificationPhone     String?
  delayHours            Int?
  reminderCount         Int?
  reminderIntervalHours Int?
  aiMaxTurns            Int?

  targetedCount     Int              @default(0)
  contactedCount    Int              @default(0)
  repliedCount      Int              @default(0)
  complainedCount   Int              @default(0)
  completedCount    Int              @default(0)
  noResponseCount   Int              @default(0)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  launchedAt        DateTime?
  completedAt       DateTime?

  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  patients          CampaignPatient[]
}

model CampaignPatient {
  id               String                @id @default(cuid())
  campaignId       String
  clinicId         String

  clinopsPatientId Int?
  patientName      String
  cin              String?
  sexe             String?
  ageYears         Int?
  ville            String?
  pays             String?
  phone            String
  phoneSecondaire  String?
  soldeImpaye      String?

  visitDate        DateTime
  prestation       String
  medecinTraitant  String

  patientSnapshot  Json

  status           CampaignPatientStatus @default(PENDING)
  language         Language?
  turnCount        Int                   @default(0)
  remindersSent    Int                   @default(0)
  messages         Json                  @default("[]")
  outcome          ConversationOutcome?

  // ── Outbound delivery tracking ──
  // The Meta message id (wamid) of the opening template message, used to match
  // delivery status webhooks back to this patient.
  outboundMessageId String?
  // Reflects the latest delivery status reported by Meta for the opening message.
  deliveryStatus    DeliveryStatus?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  contactedAt      DateTime?
  repliedAt        DateTime?
  completedAt      DateTime?
  parkedAt         DateTime?             // set when job fires during PAUSED campaign

  campaign         Campaign              @relation(fields: [campaignId], references: [id])
  complaints       Complaint[]
  bookingRequests  BookingRequest[]
  handoffs         Handoff[]
}

// ─── Complaint ────────────────────────────────────────────────────────────────
model Complaint {
  id                 String            @id @default(cuid())
  campaignPatientId  String
  clinicId           String

  type               ComplaintType
  severity           ComplaintSeverity
  triggeringMessage  String
  summary            String
  status             ComplaintStatus   @default(NEW)
  staffNote          String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  reviewedAt         DateTime?
  resolvedAt         DateTime?

  campaignPatient    CampaignPatient   @relation(fields: [campaignPatientId], references: [id])
}

// ─── Booking Request ──────────────────────────────────────────────────────────
// Source-agnostic review queue: campaign (AI-negotiated, loose preferences) and
// inbound (patient picked an exact doctor/date/time interactively) both land
// here as PENDING, and staff confirm/reject from the same admin dashboard.
model BookingRequest {
  id                 String               @id @default(cuid())
  source             BookingSource        @default(CAMPAIGN)
  campaignPatientId  String?              // CAMPAIGN only
  clinicId           String
  appointmentId      String?              @unique

  // INBOUND only — no CampaignPatient row exists to hang identity off
  patientName        String?
  patientPhone       String?
  language           Language?
  clinopsPatientId   Int?

  preferredSpecialty String?
  preferredDoctor    String?
  preferredDateRange String?
  // INBOUND only — the exact slot the patient already picked
  requestedDate      String?
  requestedTime      String?

  reason             String?
  rawPatientRequest  String

  status             BookingRequestStatus @default(PENDING)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  confirmedAt        DateTime?

  campaignPatient    CampaignPatient?     @relation(fields: [campaignPatientId], references: [id])
  appointment        Appointment?         @relation(fields: [appointmentId], references: [id])
}

// ─── Handoff ──────────────────────────────────────────────────────────────────
// Unified "patient wants a human" record for both inbound and campaign flows.
// Durable counterpart to the previous Redis-only tracking — dashboard-visible
// and auditable regardless of source.
model Handoff {
  id                String        @id @default(cuid())
  clinicId          String
  source            BookingSource
  phone             String
  patientName       String?
  campaignPatientId String?       // CAMPAIGN only
  reason            String?
  language          Language?
  status            HandoffStatus @default(OPEN)
  messages          Json          @default("[]")

  createdAt         DateTime      @default(now())
  lastActivityAt    DateTime      @default(now())
  resolvedAt        DateTime?

  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  campaignPatient   CampaignPatient? @relation(fields: [campaignPatientId], references: [id])
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Language {
  FR
  AR
  EN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AdminRole {
  SUPER_ADMIN
  CLINIC_ADMIN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
}

enum CampaignPatientStatus {
  PENDING       // not yet contacted
  PARKED        // job fired while campaign was PAUSED — waiting for resume
  CONTACTED     // opening message sent, no reply yet
  REPLIED       // patient replied at least once
  COMPLETED     // conversation closed naturally
  OPTED_OUT     // patient asked to stop
  NO_RESPONSE   // never replied after all reminders
}

enum ConversationOutcome {
  COMPLETED
  COMPLAINED
  REBOOKED
  HANDED_OFF
  URGENT
  OPTED_OUT
  NO_RESPONSE
}

enum ComplaintType {
  COMPLAINT
  MEDICAL_CONCERN
  URGENT
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum BookingSource {
  INBOUND
  CAMPAIGN
}

enum HandoffStatus {
  OPEN
  ADMIN_HANDLING
  RESOLVED
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
  WARNING
  FAILED
}

// ─── AI Usage Tracking ────────────────────────────────────────────────────────
model AiUsage {
  id                 String    @id @default(cuid())
  clinicId           String
  campaignId         String
  campaignPatientId  String
  inputTokens        Int
  outputTokens       Int
  model              String
  createdAt          DateTime  @default(now())

  @@index([clinicId, campaignId, campaignPatientId])
}

enum MessageKey {
  WELCOME
  LANGUAGE_PROMPT
  ASK_NAME
  SELECT_SPECIALTY
  SELECT_DOCTOR
  SELECT_DATE
  SELECT_TIME
  CONFIRM_BOOKING
  BOOKING_SUCCESS
  BOOKING_REQUEST_RECEIVED
  BOOKING_CANCELLED
  FAQ_INTRO
  FAQ_NOT_FOUND
  FAQ_FOLLOW_UP
  FAQ_LIST_PROMPT
  FALLBACK
  HANDOFF_TRIGGERED
  HANDOFF_RESOLVED
  SESSION_EXPIRED
  NO_SLOTS_AVAILABLE
  OUTSIDE_HOURS
  ERROR_MISSING_INFO
  ERROR_DOCTOR_NOT_FOUND
  ERROR_SPECIALTY_NOT_FOUND
  ERROR_MISSING_SPECIALTY
  ERROR_MISSING_DOCTOR
  BUTTON_CONFIRM
  BUTTON_CANCEL
  BUTTON_BOOK_APP
  BUTTON_FAQ
  BUTTON_AGENT
  BUTTON_MENU
  BUTTON_FRENCH
  BUTTON_ENGLISH
  HEADER_SPECIALTIES
  HEADER_DOCTORS
  HEADER_TIMES
  HEADER_SELECT_TIME
  NO_DOCTORS_FOR_SPECIALTY
  NO_SPECIALTIES_AVAILABLE
  HANDOFF_WAITING
  BUTTON_FAQ_LIST
  HEADER_SELECT_FAQ
  HEADER_TIME_PAGE
  CAMPAIGN_OPENING_MESSAGE
  CAMPAIGN_REMINDER_MESSAGE
  CAMPAIGN_URGENT_MESSAGE
  CAMPAIGN_HANDOFF_MESSAGE
  CAMPAIGN_REBOOK_CONFIRM
  CAMPAIGN_FAREWELL_MESSAGE
}
